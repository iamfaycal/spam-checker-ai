# Server
PORT=3000
# Number of reverse-proxy hops to trust for the client IP (Traefik on Coolify = 1). See D7.
TRUST_PROXY=1
# Directory of the built client, served by Express in production (set in the Docker image)
# STATIC_DIR=/app/client/dist

# LLM
LLM_PROVIDER=google
# Required unless LLM_PROVIDER=google (then defaults to gemini-3.5-flash-lite)
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=15000
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Rate limits (see D6)
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=20
GLOBAL_PER_MINUTE=12
GLOBAL_DAILY_CAP=400
